patch=1,EE,004FA340,word,00102AC2

// ---- Loose STREAMS de ASSETSudio\streams\ (DESATIVADO) ------------
//    0x447CB0:  sb a1,4(s0)  ->  sb zero,4(s0)
//    Forcava o flag de origem do audio para 0 = "pasta solta". Quebrou todo
//    o audio no teste; fica registrado para quem quiser retomar.
//    Popular a pasta com (uma linha):
//      python hash_build.py X streams.dat -o ASSETS/audio/streams -nl MC3_PS2_Streams.lst -a mclub
// patch=0,EE,00447CB0,word,A2000004
// patch=1,EE,00447CB0,word,A2000004
